{
  "desktop": { "appId": "io.github.yugo616.wechatdot", "windowWidth": 420, "minContentHeight": 300, "maxContentHeight": 720 },
  "weixin": {
    "baseUrl": "https://ilinkai.weixin.qq.com",
    "cdnUrl": "https://novac2c.cdn.weixin.qq.com/c2c",
    "botType": "3",
    "appId": "bot",
    "channelVersion": "2.4.9",
    "requestTimeoutMs": 20000,
    "longPollTimeoutMs": 40000,
    "retryDelayMs": 3000,
    "maxTextLength": 2000,
    "voiceSampleRate": 24000
  },
  "dot": {
    "identity": { "name": "WeChat Dot 专用", "color": "#32836d" },
    "browser": "external",
    "extension": {"port":43127,"heartbeatMs":20000,"maxPayloadBytes":8388608,"publicKey":""},
    "browserProbeTimeoutMs": 1000,
    "backgroundArguments": ["--disable-background-timer-throttling", "--disable-backgrounding-occluded-windows", "--disable-renderer-backgrounding"],
    "runtime": {
      "version": "155.0.8059.79",
      "baseUrl": "https://storage.googleapis.com/chrome-for-testing-public",
      "downloadTimeoutMs": 300000,
      "setupTimeoutMs": 30000,
      "profileDirectory": "ChatGPT Browser v2",
      "platforms": {
        "darwin-arm64": {
          "platform": "mac-arm64",
          "archive": "chrome-mac-arm64.zip",
          "executable": "chrome-mac-arm64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing"
        },
        "darwin-x64": {
          "platform": "mac-x64",
          "archive": "chrome-mac-x64.zip",
          "executable": "chrome-mac-x64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing"
        },
        "win32-x64": {
          "platform": "win64",
          "archive": "chrome-win64.zip",
          "executable": "chrome-win64/chrome.exe"
        }
      }
    },
    "homeUrl": "https://chatgpt.com/",
    "apiPrefixes": ["/backend-api", "/__codex-api"],
    "primaryPath": "/tbo/primary",
    "profilePath": "/tbo/by-thread/{threadId}",
    "conversationPath": "/dots/home",
    "sessionPath": "/api/auth/session",
    "roomPath": "/messaging/rooms/{roomId}",
    "messagesPath": "/messaging/rooms/{roomId}/messages",
    "filesPath": "/messaging/rooms/{roomId}/files/{fileId}",
    "transcribePath": "/transcribe",
    "pollIntervalMs": 5000,
    "composerPollIntervalMs": 100,
    "requestTimeoutMs": 30000,
    "sendTimeoutMs": 60000,
    "uploadTimeoutMs": 120000,
    "historyPageSize": 20,
    "composerSelectors": ["#prompt-textarea", "[contenteditable='true'][role='textbox']", "textarea"],
    "fileInputSelectors": ["input[type='file'][multiple]", "input[type='file']"],
    "draftAttachmentSelectors": ["input[type='file']", "[data-testid*='attachment']", "img[src^='blob:']", "button[aria-label*='Remove']", "button[aria-label*='移除']", "button[aria-label*='删除']", "button[aria-label*='取消上传']"],
    "sendSelectors": ["[data-testid='send-button']", "button[aria-label='Send message']", "button[aria-label='发送消息']", "button[aria-label='Send']", "button[aria-label='发送']", "button[aria-label='傳送']"]
  },
  "storage": { "maxMediaBytes": 26214400, "mediaRetentionHours": 24, "completedHistoryLimit": 2000, "maxBacklogAgeMs": 600000 },
  "updates": { "releaseUrl": "https://github.com/Yugo616/wechat-dot/releases", "feed": { "provider": "github", "owner": "Yugo616", "repo": "wechat-dot" } }
}
